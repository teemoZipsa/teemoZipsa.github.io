{
  "scripts": {
    "check:rules": "node scripts/check-rules.mjs",
    "check:diff": "git diff --check HEAD",
    "audit:vendor": "node scripts/audit-vendor.mjs",
    "audit:vendor:integrity": "node scripts/audit-vendor.mjs --integrity-only",
    "audit:formulas": "node scripts/audit-formulas.mjs",
    "audit:formula-pages": "node scripts/audit-formula-pages.mjs",
    "audit:functional": "node scripts/audit-functional-edges.mjs",
    "audit:accessibility": "node scripts/audit-accessibility.mjs",
    "audit:browsers": "node scripts/audit-browser-matrix.mjs",
    "audit:interactions": "node scripts/audit-interactions.mjs",
    "audit:background-inference": "node scripts/audit-interactions.mjs --background-inference --filter=background-removal --browser=chromium && node scripts/audit-interactions.mjs --background-inference --filter=background-removal --browser=firefox",
    "audit:pages": "node scripts/audit-pages.mjs",
    "audit:seo": "node scripts/audit-seo-index.mjs",
    "audit:tool-quality": "node scripts/audit-tool-quality.mjs",
    "verify": "npm run check:rules && npm run audit:tool-quality && npm run audit:vendor:integrity && npm run audit:formulas && npm run audit:formula-pages && npm run audit:functional && npm run audit:seo && npm run audit:interactions && npm run audit:accessibility && npm run audit:pages && npm run audit:browsers && npm run check:diff",
    "release:check": "npm run audit:vendor && npm run verify"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "parse5": "^8.0.1",
    "playwright": "^1.61.1"
  }
}
